BACKEND_URL=http://localhost:8080
# Optional override. By default Next derives this as BACKEND_URL + /ws.
NEXT_PUBLIC_WEBSOCKET_URL=http://localhost:8080/ws
# Local by default. Keep false in production until the private test is complete.
NEXT_PUBLIC_AI_FEATURES_ENABLED=true
NEXT_PUBLIC_AI_COACH_ENABLED=true
NEXT_PUBLIC_AI_ROAST_ENABLED=true
