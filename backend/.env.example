SPRING_PROFILE=prod
PORT=8080

# Spring expects a JDBC URL, for example:
# jdbc:postgresql://host/database?sslmode=require
DATABASE_URL=
DATABASE_USER=
DATABASE_PASSWORD=

# Generate at least 32 random bytes and Base64-encode them.
JWT_SECRET=
JWT_EXPIRATION_MILLIS=86400000

# Keep false during migrations and staging verification. Enable only after the
# active gameweek and transfer-window state have been checked.
SCHEDULING_ENABLED=false

CORS_ALLOWED_ORIGINS=https://fantasy-draft-sigma.vercel.app
WEBSOCKET_ALLOWED_ORIGIN_PATTERNS=https://fantasy-draft-sigma.vercel.app
WAIVER_OFFLINE_GRACE_SECONDS=30
WAIVER_POLL_MILLIS=5000
