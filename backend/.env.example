SPRING_PROFILE=prod
PORT=8080

# Spring expects a JDBC URL, for example:
# jdbc:postgresql://host/database?sslmode=require
DATABASE_URL=
DATABASE_USER=
DATABASE_PASSWORD=

# Generate at least 32 random bytes and Base64-encode them.
JWT_SECRET=
JWT_EXPIRATION_MILLIS=86400000
# Required on HTTPS deployments. Keep false only for local HTTP development.
AUTH_COOKIE_SECURE=true

# Transactional authentication email (Resend free tier is sufficient for the
# small league). MAIL_FROM must use a domain verified in the Resend dashboard.
APP_PUBLIC_URL=https://your-frontend.example
MAIL_PROVIDER=resend
MAIL_FROM=Fantasy Draft <no-reply@mail.your-domain.example>
RESEND_API_KEY=

# Keep false during migrations and staging verification. Enable only after the
# active gameweek and transfer-window state have been checked.
SCHEDULING_ENABLED=false
AUTOMATIC_TURN_DELAY=2s

CORS_ALLOWED_ORIGINS=https://fantasy-draft-sigma.vercel.app
WEBSOCKET_ALLOWED_ORIGIN_PATTERNS=https://fantasy-draft-sigma.vercel.app
WAIVER_OFFLINE_GRACE_SECONDS=30
WAIVER_POLL_MILLIS=5000
# Optional Groq Free Plan integration. The roast uses one provider request per
# league/gameweek, never retries a failed/rate-limited request, and falls back locally.
AI_ENABLED=false
AI_PROVIDER=groq
AI_API_KEY=
AI_MODEL=openai/gpt-oss-20b
AI_COACH_ENABLED=false
AI_ROAST_ENABLED=false
AI_ROAST_ROTATION_SECONDS=30

# Generate once for production and keep the private key only in Render.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@your-domain.example
